# {{ ansible_managed }}
# Read only on the first start (while there is no proxysql.db).
# When the file changes, the role recreates proxysql.db.
# Only settings that require a restart are here. The rest is in /etc/proxysql-ansible.sql.

datadir="/var/lib/proxysql"
errorlog="/var/lib/proxysql/proxysql.log"

admin_variables=
{
    admin_credentials="{{ proxysql_admin_user }}:{{ proxysql_admin_password }}"
    mysql_ifaces="127.0.0.1:{{ proxysql_admin_port }}"
}

mysql_variables=
{
    threads={{ proxysql_threads }}
    interfaces="0.0.0.0:{{ proxysql_mysql_port }}"
}
